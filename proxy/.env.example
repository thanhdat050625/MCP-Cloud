# Server Port (Render tự động gán PORT=10000)
PORT=10000

# Danh sách proxy trung gian kích hoạt (phân cách dấu phẩy, vd: headroom)
ENABLED_PROXIES=headroom

# Port nội bộ cho Headroom Proxy
HEADROOM_INTERNAL_PORT=8787

# Giới hạn ngưỡng RAM tối đa (MB) trước khi Watchdog dọn dẹp
MAX_RAM_MB=380.0

# Lưu trữ trên đĩa (SQLite, lịch sử, học patterns)
HEADROOM_STATELESS=false
HEADROOM_TELEMETRY=off
HEADROOM_SMART_ROUTING=false
HEADROOM_CODE_AWARE_ENABLED=false
MALLOC_TRIM_THRESHOLD_=100000
PYTHONUNBUFFERED=1
